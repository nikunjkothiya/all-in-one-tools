# Frontend Environment Configuration

# URL of the backend API server
# Default for development: http://localhost:5000
REACT_APP_API_URL=http://localhost:5000

# Optional: Base path for the API (defaults to /api)
REACT_APP_API_BASE=/api

# Monetization settings are fetched from the backend admin panel.
# No Google or Meta IDs should be stored in the frontend env file.
